# Markdown to PowerPoint Generator Environment Configuration

# Default PowerPoint Template Path (defaults to corporate_template.pptx in project root)
# DEFAULT_PPTX_TEMPLATE=corporate_template.pptx

# Path to LibreOffice executable (soffice / soffice.exe) for PDF export
# LIBREOFFICE_BINARY=C:\Program Files\LibreOffice\program\soffice.exe

# Maximum allowed file upload size in megabytes for REST API (default: 50)
# MAX_UPLOAD_SIZE_MB=50

# DOJO RAG Endpoint Settings (Optional development tool for fetching Markdown)
# DOJO_ENDPOINT=https://mc-apps.molecularconnections.dev/MCPROMPTPILOT_API/api/v1/dojo_chat_pdf
# DOJO_LOGIN_ID=PowerPointTest_IT
# DOJO_PROJECT=dojo
# DOJO_MODEL=gemini-3-flash-preview
